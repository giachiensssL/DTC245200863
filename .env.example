# =============================================================================
# .env.example — DTC245200863-topic3-wordpress-product
# Sao chép file này thành .env và điền giá trị thực
# KHÔNG commit file .env vào Git
# =============================================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me_root_password_123
MYSQL_DATABASE=wordpress_db
MYSQL_USER=wordpress_user
MYSQL_PASSWORD=change_me_wp_password_456

# --- WordPress ---
WORDPRESS_DB_HOST=mysql:3306
WORDPRESS_DB_NAME=wordpress_db
WORDPRESS_DB_USER=wordpress_user
WORDPRESS_DB_PASSWORD=change_me_wp_password_456
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_DEBUG=false
WORDPRESS_SITE_URL=http://localhost

# --- Host access ---
# Set 0.0.0.0 to allow access from other devices on your LAN.
# Set WORDPRESS_SITE_URL to http://<host-LAN-IP> and allow HTTP_PORT in the firewall.
WEB_BIND_ADDRESS=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
PHPMYADMIN_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100

# --- phpMyAdmin ---
PMA_HOST=mysql
PMA_PORT=3306
UPLOAD_LIMIT=64M

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me_grafana_password_789
GF_USERS_ALLOW_SIGN_UP=false
GF_SERVER_ROOT_URL=http://localhost:3000

# --- MySQL Exporter ---
MYSQL_EXPORTER_USER=exporter
MYSQL_EXPORTER_PASSWORD=change_me_exporter_password_321

# --- Prometheus ---
PROMETHEUS_RETENTION_TIME=15d

# --- Loki ---
LOKI_RETENTION_PERIOD=168h

# --- Project ---
COMPOSE_PROJECT_NAME=techpro_wp
